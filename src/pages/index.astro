---
import { Picture, Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import {
  company,
  nav,
  stats,
  aboutPoints,
  qualityPolicy,
  vision,
  mission,
  machines,
  industries,
  process,
  certifications,
} from '../data/site';

import logo from '../assets/logo.png';
import makeInIndia from '../assets/make-in-india.png';
import aboutImg from '../assets/about-innovation.png';
import rdx20 from '../assets/machine-rdx-20.png';
import vl1200 from '../assets/machine-vl-1200.png';
import vl1050 from '../assets/machine-vl-1050.png';
import processChart from '../assets/process-chart.png';
import isoCert from '../assets/cert-iso-9001.jpg';
import msmeCert from '../assets/cert-msme.jpg';

const machineImages = { rdx20, vl1200, vl1050 };
const certImages = { iso: isoCert, msme: msmeCert };

const year = new Date().getFullYear();
---

<Base
  title={`${company.name} | ${company.tagline}`}
  description="ISO 9001:2015 certified precision engineering and CNC machining company in Bengaluru since 2003, serving aerospace, telecom, power, medical and machine guard segments."
>
  <div id="top" class="top-sentinel" aria-hidden="true"></div>
  <Header />

  <main id="main">
    <!-- ===== Hero ===== -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="container hero-inner">
        <div class="hero-copy">
          <p class="hero-kicker animate-in">
            <Icon name="lucide:badge-check" aria-hidden="true" /> ISO 9001:2015 certified · Since {
              company.since
            }
          </p>
          <h1 id="hero-title" class="animate-in" style="--delay:120ms">
            Precision engineering, <span>made in India.</span>
          </h1>
          <p class="hero-lead animate-in" style="--delay:240ms">
            {company.name} delivers products of global standards to aerospace, telecom, power,
            medical and industrial customers, with the vision of “Make in India”.
          </p>
          <div class="hero-actions animate-in" style="--delay:360ms">
            <a href="#contact" class="btn btn--primary">
              Request a quote <Icon name="lucide:arrow-right" aria-hidden="true" />
            </a>
            <a href="#machines" class="btn btn--ghost">See our machines</a>
          </div>
        </div>
        <div class="hero-visual animate-in" style="--delay:200ms">
          <Image
            src={logo}
            alt={`${company.name} logo`}
            widths={[320, 480, 640, 960]}
            sizes="(max-width: 640px) 240px, (max-width: 1100px) 340px, 460px"
            quality={95}
            loading="eager"
            fetchpriority="high"
            class="hero-logo"
          />
          <Image
            src={makeInIndia}
            alt="Make in India"
            widths={[180, 360]}
            sizes="180px"
            class="hero-mii"
            loading="eager"
          />
        </div>
      </div>
    </section>

    <!-- ===== Stats strip ===== -->
    <section class="stats" aria-label="Company highlights">
      <div class="container">
        <ul role="list" class="stats-grid">
          {
            stats.map((s, i) => (
              <li data-reveal style={`--delay:${i * 100}ms`}>
                <strong>{s.value}</strong>
                <span>{s.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ===== About ===== -->
    <section id="about" class="section" aria-labelledby="about-title">
      <div class="container about">
        <div class="about-media" data-reveal="left">
          <Picture
            src={aboutImg}
            formats={['avif', 'webp']}
                    fallbackFormat="webp"
            widths={[480, 800, 1200]}
            sizes="(max-width: 900px) 100vw, 560px"
            alt="Light bulbs labelled innovation, technology, vision and teamwork"
          />
          <div class="about-badge">
            <strong>{year - company.since}+</strong>
            <span>years of engineering</span>
          </div>
        </div>
        <div class="about-copy" data-reveal="right">
          <p class="eyebrow">About us</p>
          <h2 id="about-title">Pioneering innovative solutions since {company.since}</h2>
          <p>
            VIJAY INNOVATION TECHNOLOGY, an ISO 9001:2015 certified company, has been in business
            since {company.since}, run by a professionally managed group of experienced and aspiring
            engineers.
          </p>
          <p>
            Now, with the vision and objective of the “Make in India” concept, we are focusing on
            delivering products of global standards to various industrial segments.
          </p>
          <ul role="list" class="about-points">
            {
              aboutPoints.map((p) => (
                <li>
                  <span class="icon-badge">
                    <Icon name={p.icon} aria-hidden="true" />
                  </span>
                  <div>
                    <h3>{p.title}</h3>
                    <p>{p.text}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- ===== Quality policy ===== -->
    <section id="quality" class="section section--dark" aria-labelledby="quality-title">
      <div class="container">
        <div class="section-head section-head--center" data-reveal>
          <p class="eyebrow">Quality policy</p>
          <h2 id="quality-title">Our commitment to excellence</h2>
          <p>Under commit, over deliver. Quality is built into every step of our operations.</p>
        </div>
        <ul role="list" class="quality-grid">
          {
            qualityPolicy.map((q, i) => (
              <li class="quality-card" data-reveal style={`--delay:${i * 80}ms`}>
                <span class="icon-badge">
                  <Icon name={q.icon} aria-hidden="true" />
                </span>
                <h3>{q.title}</h3>
                <p>{q.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ===== Vision & mission ===== -->
    <section id="vision-mission" class="section section--alt" aria-labelledby="vm-title">
      <div class="container">
        <div class="section-head section-head--center" data-reveal>
          <p class="eyebrow">Vision &amp; mission</p>
          <h2 id="vm-title">The principles that drive us</h2>
        </div>
        <div class="vm-grid">
          <article class="card vm-card" data-reveal="left">
            <span class="icon-badge"><Icon name="lucide:eye" aria-hidden="true" /></span>
            <h3>Our vision</h3>
            <ul>{vision.map((v) => <li>{v}</li>)}</ul>
          </article>
          <article class="card vm-card vm-card--gold" data-reveal="right" style="--delay:100ms">
            <span class="icon-badge"><Icon name="lucide:rocket" aria-hidden="true" /></span>
            <h3>Our mission</h3>
            <ul>{mission.map((m) => <li>{m}</li>)}</ul>
          </article>
        </div>
      </div>
    </section>

    <!-- ===== Machines ===== -->
    <section id="machines" class="section" aria-labelledby="machines-title">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Our machines</p>
          <h2 id="machines-title">Advanced CNC capability for precision parts</h2>
          <p>Vertical machining centres with modern Siemens and Mitsubishi controls.</p>
        </div>
        <div class="machines-grid">
          {
            machines.map((m, i) => (
              <article class="card machine" data-reveal style={`--delay:${i * 80}ms`}>
                <div class="machine-media">
                  <Picture
                    src={machineImages[m.image]}
                    formats={['avif', 'webp']}
                    fallbackFormat="webp"
                    widths={[400, 640, 900]}
                    sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 380px"
                    alt={`${m.name} vertical machining centre`}
                  />
                </div>
                <div class="machine-body">
                  <h3>{m.name}</h3>
                  <dl>
                    {m.specs.map(([k, v]) => (
                      <div>
                        <dt>{k}</dt>
                        <dd>{v}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ===== Industries ===== -->
    <section id="industries" class="section section--alt" aria-labelledby="ind-title">
      <div class="container">
        <div class="section-head section-head--center" data-reveal>
          <p class="eyebrow">Products &amp; segments</p>
          <h2 id="ind-title">Industries we serve</h2>
          <p>Delivering precision engineering solutions across diverse industries.</p>
        </div>
        <ul role="list" class="industry-grid">
          {
            industries.map((s, i) => (
              <li class="card industry" data-reveal="zoom" style={`--delay:${i * 80}ms`}>
                <span class="icon-badge">
                  <Icon name={s.icon} aria-hidden="true" />
                </span>
                <h3>{s.title}</h3>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ===== Process ===== -->
    <section id="process" class="section" aria-labelledby="process-title">
      <div class="container">
        <div class="section-head process-head" data-reveal>
          <div>
            <p class="eyebrow">Our process</p>
            <h2 id="process-title">Quality at every stage</h2>
            <p>A streamlined workflow from enquiry to delivery, with quality checks built in.</p>
          </div>
          <button class="btn btn--outline" type="button" data-open="dlg-process">
            <Icon name="lucide:maximize-2" aria-hidden="true" /> View full process chart
          </button>
        </div>
        <ol class="process-list">
          {
            process.map((p, i) => (
              <li class="process-step" data-reveal style={`--delay:${i * 70}ms`}>
                <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="icon-badge">
                  <Icon name={p.icon} aria-hidden="true" />
                </span>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
      <dialog id="dlg-process" class="viewer" aria-label="Process flow chart">
        <form method="dialog" class="viewer-bar">
          <strong>Process flow chart</strong>
          <button class="viewer-close" aria-label="Close">
            <Icon name="lucide:x" aria-hidden="true" />
          </button>
        </form>
        <Picture
          src={processChart}
          formats={['avif', 'webp']}
                    fallbackFormat="webp"
          widths={[640, 1152]}
          sizes="(max-width: 1200px) 95vw, 1152px"
          alt="Process flow chart: customer, OEM team, design, production, quality and purchase departments, inspection, quality check, delivery and feedback"
          loading="lazy"
        />
      </dialog>
    </section>

    <!-- ===== Certifications ===== -->
    <section id="certifications" class="section section--alt" aria-labelledby="cert-title">
      <div class="container">
        <div class="section-head section-head--center" data-reveal>
          <p class="eyebrow">Certifications</p>
          <h2 id="cert-title">Standards that define our work</h2>
          <p>Tap a certificate to view it.</p>
        </div>
        <div class="cert-grid">
          {
            certifications.map((c, i) => (
              <button
                type="button"
                class="card cert"
                data-open={`dlg-${c.id}`}
                data-reveal
                style={`--delay:${i * 80}ms`}
              >
                <span class="cert-thumb">
                  <Picture
                    src={certImages[c.image]}
                    formats={['avif', 'webp']}
                    fallbackFormat="webp"
                    widths={[240, 480]}
                    sizes="200px"
                    alt=""
                  />
                </span>
                <span class="cert-body">
                  <span class="cert-title">{c.title}</span>
                  <span class="cert-text">{c.text}</span>
                  <span class="cert-link">
                    View certificate <Icon name="lucide:arrow-right" aria-hidden="true" />
                  </span>
                </span>
              </button>
            ))
          }
        </div>
      </div>
      {
        certifications.map((c) => (
          <dialog id={`dlg-${c.id}`} class="viewer viewer--doc" aria-label={`${c.title} certificate`}>
            <form method="dialog" class="viewer-bar">
              <strong>{c.title}</strong>
              <button class="viewer-close" aria-label="Close">
                <Icon name="lucide:x" aria-hidden="true" />
              </button>
            </form>
            <Picture
              src={certImages[c.image]}
              formats={['avif', 'webp']}
                    fallbackFormat="webp"
              widths={[600, 1000, 1240]}
              sizes="(max-width: 800px) 95vw, 760px"
              alt={`${c.title} certificate of ${company.name}`}
              loading="lazy"
            />
          </dialog>
        ))
      }
    </section>

    <!-- ===== Careers ===== -->
    <section id="careers" class="section" aria-labelledby="careers-title">
      <div class="container">
        <div class="careers card" data-reveal="zoom">
          <span class="icon-badge"><Icon name="lucide:briefcase" aria-hidden="true" /></span>
          <div>
            <p class="eyebrow">Careers</p>
            <h2 id="careers-title">Join our team of innovative professionals</h2>
            <p>
              There are no open positions right now. We are always happy to hear from skilled
              machinists, programmers and quality engineers, so feel free to send us your resume.
            </p>
          </div>
          <a class="btn btn--blue" href={`mailto:${company.email}?subject=Job%20application`}>
            <Icon name="lucide:mail" aria-hidden="true" /> Email your resume
          </a>
        </div>
      </div>
    </section>

    <!-- ===== Contact ===== -->
    <section id="contact" class="section section--dark" aria-labelledby="contact-title">
      <div class="container contact">
        <div class="contact-info" data-reveal="left">
          <p class="eyebrow">Contact us</p>
          <h2 id="contact-title">Let's build your next part together</h2>
          <p class="contact-lead">
            We are located in Bengaluru, the heart of India's technology and manufacturing hub.
            Send us your drawing or requirement and we'll get back to you.
          </p>
          <ul role="list" class="contact-list">
            <li>
              <span class="icon-badge"><Icon name="lucide:phone" aria-hidden="true" /></span>
              <div>
                <span class="label">Phone</span>
                <a href={company.phoneHref}>{company.phone}</a>
              </div>
            </li>
            <li>
              <span class="icon-badge"><Icon name="lucide:mail" aria-hidden="true" /></span>
              <div>
                <span class="label">Email</span>
                <a href={`mailto:${company.email}`}>{company.email}</a>
              </div>
            </li>
            <li>
              <span class="icon-badge"><Icon name="lucide:map-pin" aria-hidden="true" /></span>
              <div>
                <span class="label">Address</span>
                <a href={company.mapsHref} target="_blank" rel="noopener">{company.address}</a>
              </div>
            </li>
            <li>
              <span class="icon-badge"><Icon name="lucide:clock" aria-hidden="true" /></span>
              <div>
                <span class="label">Working hours</span>
                <span>{company.hours}</span>
              </div>
            </li>
          </ul>
        </div>
        <div class="contact-form" data-reveal="right" data-form>
          <h3>Send us a message</h3>
          <p class="form-intro">
            Share your drawing, quantity and timeline using our enquiry form, or reach us directly.
          </p>
          <button type="button" class="btn btn--primary form-open" data-form-open>
            <Icon name="lucide:clipboard-list" aria-hidden="true" /> Open the enquiry form
          </button>
          <div class="form-alt">
            <a class="btn btn--outline" href={company.phoneHref}>
              <Icon name="lucide:phone" aria-hidden="true" /> Call us
            </a>
            <a class="btn btn--outline" href={`mailto:${company.email}`}>
              <Icon name="lucide:mail" aria-hidden="true" /> Email us
            </a>
          </div>
          <template data-form-tpl>
            <iframe src={company.formUrl} title="Enquiry form" class="form-frame"></iframe>
          </template>
        </div>
      </div>
    </section>
  </main>

  <!-- ===== Footer ===== -->
  <footer class="footer">
    <div class="container footer-grid">
      <div class="footer-about">
        <div class="footer-brand">
          <img src="/brand/logo-mark-2x.png" srcset="/brand/logo-mark-1x.png 1x, /brand/logo-mark-2x.png 2x, /brand/logo-mark-3x.png 3x" alt="" width="113" height="72" loading="lazy" />
          <div>
            <strong>{company.name}</strong>
            <span>Since {company.since}</span>
          </div>
        </div>
        <p>
          Committed to delivering products of global standards to various industrial segments with
          the vision of “Make in India”.
        </p>
        <Image src={makeInIndia} alt="Make in India" width={150} class="footer-mii" />
      </div>
      <nav aria-label="Footer">
        <h3>Quick links</h3>
        <ul role="list">
          {
            nav.map((n) => (
              <li>
                <a href={n.href}>{n.label}</a>
              </li>
            ))
          }
          <li><a href="#contact">Contact</a></li>
        </ul>
      </nav>
      <div>
        <h3>Get in touch</h3>
        <ul role="list" class="footer-contact">
          <li><Icon name="lucide:map-pin" aria-hidden="true" /> {company.address}</li>
          <li>
            <Icon name="lucide:mail" aria-hidden="true" />
            <a href={`mailto:${company.email}`}>{company.email}</a>
          </li>
          <li>
            <Icon name="lucide:phone" aria-hidden="true" />
            <a href={company.phoneHref}>{company.phone}</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="container copyright">
      <p>© {year} {company.name}. All rights reserved.</p>
    </div>
  </footer>
</Base>

<script>
  // Reveal sections as they scroll into view.
  const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -8% 0px' },
    );
    items.forEach((el) => io.observe(el));
  } else {
    items.forEach((el) => el.classList.add('is-visible'));
  }

  // The Google Form is heavy, so it only loads when someone asks for it.
  const formBox = document.querySelector<HTMLElement>('[data-form]');
  formBox?.querySelector('[data-form-open]')?.addEventListener('click', () => {
    const tpl = formBox.querySelector<HTMLTemplateElement>('[data-form-tpl]')!;
    formBox.querySelectorAll('.form-intro, .form-open, .form-alt').forEach((el) => el.remove());
    formBox.append(tpl.content.cloneNode(true));
    formBox.classList.add('is-loaded');
  });

  // Image viewers (certificates and process chart).
  document.querySelectorAll<HTMLElement>('[data-open]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const dlg = document.getElementById(btn.dataset.open!) as HTMLDialogElement | null;
      dlg?.showModal();
    });
  });
  document.querySelectorAll<HTMLDialogElement>('dialog.viewer').forEach((dlg) => {
    // Close when the backdrop is clicked.
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
  });
</script>

<style>
  .top-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 40px;
  }

  /* ----- Hero ----- */
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(100svh, 860px);
    display: flex;
    align-items: center;
    padding: calc(var(--header-h) + 3rem) 0 4rem;
    color: #fff;
    background: var(--navy-950);
    overflow: hidden;
  }

  /* Engineering-drawing grid behind the hero, drawn with CSS (no image download). */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(900px 600px at 78% 45%, rgb(29 95 209 / 32%), transparent 65%),
      radial-gradient(700px 500px at 0% 100%, rgb(212 160 23 / 10%), transparent 60%),
      linear-gradient(160deg, #0b1f3a 0%, #071426 60%);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(255 255 255 / 5%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 5%) 1px, transparent 1px),
      linear-gradient(rgb(255 255 255 / 2.5%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 2.5%) 1px, transparent 1px);
    background-size:
      96px 96px,
      96px 96px,
      24px 24px,
      24px 24px;
    mask-image: radial-gradient(ellipse 80% 70% at 60% 45%, #000 30%, transparent 85%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 60% 45%, #000 30%, transparent 85%);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .hero-visual {
    position: relative;
    display: grid;
    justify-items: center;
  }

  .hero-logo {
    width: min(100%, 460px);
    height: auto;
  }

  .hero-copy {
    max-width: 720px;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem;
    margin-bottom: 1.5rem;
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: 999px;
    background: rgb(255 255 255 / 8%);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .hero-kicker svg {
    width: 16px;
    height: 16px;
    color: var(--gold-400);
  }

  .hero h1 {
    font-size: clamp(2.3rem, 6.5vw, 4.4rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    margin-bottom: 1.25rem;
  }

  .hero h1 span {
    color: var(--gold-400);
  }

  .hero-lead {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: #d3dceb;
    max-width: 600px;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-mii {
    position: absolute;
    left: 0;
    bottom: -1rem;
    width: clamp(110px, 12vw, 160px);
    height: auto;
  }

  /* ----- Stats ----- */
  .stats {
    position: relative;
    z-index: 2;
    margin-top: -2.5rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: #fff;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    border: 1px solid var(--line);
    overflow: hidden;
  }

  .stats-grid li {
    display: grid;
    gap: 0.2rem;
    padding: 1.4rem 1.5rem;
    border-left: 1px solid var(--line);
  }

  .stats-grid li:first-child {
    border-left: 0;
  }

  .stats-grid strong {
    font-family: var(--font-head);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    color: var(--blue-600);
    line-height: 1.1;
  }

  .stats-grid span {
    font-size: 0.9rem;
    color: var(--ink-soft);
    line-height: 1.4;
  }

  /* ----- About ----- */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
